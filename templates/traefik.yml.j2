log:
  level: "{{ traefik_log_level }}"
api:
  dashboard: {{ traefik_enable_dashboard }}

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
  websecure:
    address: ":443"
  metrics:
    address: ":8082"

providers:
  docker:
    exposedByDefault: false   

certificatesResolvers:
  {% if stepca_enabled -%}
  stepca:
    acme:
      caServer: "{{ caserver_url }}"
      caCertificates:
      - /etc/ssl/homelab/certs/root_ca.crt
      storage: "{{ acme_storage_stepca }}"
      httpChallenge:
        entryPoint: web
  {% endif -%}
  {% if letsencrypt_enabled -%}
  le:
    acme:
      email: "{{ acme_email }}"
      {% if  letsencrypt_staging_enabled | bool -%}
      caServer: "{{ letsencrypt_staging_url }}"
      {% else %}
      caServer: "{{ letsencrypt_url }}"
      {% endif -%}
      storage: "{{ acme_storage_le }}"
      httpChallenge:
        entryPoint: web
  {% endif %}

metrics:
  prometheus:
    entrypoint: metrics